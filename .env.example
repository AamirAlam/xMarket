# ========================================================
# PumpIt - Event-Driven Sentiment Trading Agent
# ETHGlobal Configuration
# ========================================================

# 1. 0G Labs Private Computer (0G Compute Router API)
# Get your API key at https://pc.0g.ai or from 0G hackathon booth
ZERO_G_API_KEY=your_0g_router_key_here
ZERO_G_ROUTER_URL=https://router-api.0g.ai/v1

# 2. Definitive Flash API
# Get your key at https://flash.definitive.fi/docs/getting-started
DEFINITIVE_FLASH_API_KEY=your_definitive_flash_key_here
DEFINITIVE_FLASH_API_URL=https://flash.definitive.fi/v1

# 3. Twitter / X API v2 Bearer Token (Optional)
# If provided, enables direct official Twitter API v2 live handle polling
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# 4. Agent Wallet Address (for onchain non-custodial orders)
NEXT_PUBLIC_DEFAULT_WALLET=0x71C...498B
